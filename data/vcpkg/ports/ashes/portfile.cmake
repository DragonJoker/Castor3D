vcpkg_check_linkage(ONLY_DYNAMIC_LIBRARY)

vcpkg_from_github(
    OUT_SOURCE_PATH SOURCE_PATH
    REPO DragonJoker/Ashes
    REF ea17f3930050ce6d62e1f1a6ada9ddb16f27bf0b
    HEAD_REF master
    SHA512 4f0c7239fb8824884d24aa1f7f11b6e62199e63c0bd5a770e8c2f3de9393e29db8f38375429975fc365a4c35594ed065907dc9c760454c5a85fa807113fff0a8
)

vcpkg_from_github(
    OUT_SOURCE_PATH CMAKE_SOURCE_PATH
    REPO DragonJoker/CMakeUtils
    REF e381302963488712abc0305477e76025af74319e
    HEAD_REF master
    SHA512 545b414617c11786e652ca48bae8acc93961b67928d76dda0881dadc1441a7c4a2150bdef0a603ba8036e4e06438d3abf7e78f91aa8c973c1db7cf3dacde74d3
)


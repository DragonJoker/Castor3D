{
  "name": "tinyusdz",
  "version-date": "2026-03-04",
  "description": "Tiny, dependency-free USDZ/USDA/USDC library written in C++14.",
  "homepage": "https://github.com/lighttransport/tinyusdz",
  "license": "Apache-2.0",
  "supports": "!ios & !android & !x86 & !uwp & !arm32",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    "readusda",
    "readusdc"
  ],
  "features": {
    "readusda": {
      "description": "Allows reading USDA files."
    },
    "writeusda": {
      "description": "Allows writing USDA files."
    },
    "readusdc": {
      "description": "Allows reading USDC files."
    },
    "writeusdc": {
      "description": "Allows writing USDC files."
    }
  }
}
